{
  "name": "@univa/core",
  "type": "module",
  "version": "0.1.2",
  "description": "🚀 开箱即用的 uni-app Vite 插件集，提供完整的开发体验",
  "author": "lianghang <libre1103@163.com>",
  "license": "MIT",
  "homepage": "https://github.com/lianghang1/univa/tree/main/packages/core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lianghang1/univa.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/lianghang1/univa/issues"
  },
  "keywords": [
    "uni-app",
    "vite",
    "plugin",
    "unocss",
    "auto-import",
    "components",
    "uni-helper"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./use": {
      "import": {
        "types": "./dist/use.d.ts",
        "default": "./dist/use.js"
      },
      "require": {
        "types": "./dist/use.d.cts",
        "default": "./dist/use.cjs"
      }
    },
    "./global": {
      "types": "./dist/global.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "THIRD-PARTY-NOTICES",
    "dist"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "vite": "^5.2.8"
  },
  "dependencies": {
    "@antfu/utils": "catalog:",
    "@dcloudio/types": "3.4.28",
    "@uni-helper/eslint-config": "0.7.4",
    "@uni-helper/plugin-uni": "0.1.0",
    "@uni-helper/uni-pages-types": "0.4.6",
    "@uni-helper/uni-types": "1.1.0",
    "@uni-helper/unocss-preset-uni": "0.2.11",
    "@uni-helper/vite-plugin-uni-components": "0.3.2",
    "@uni-helper/vite-plugin-uni-layouts": "0.1.11",
    "@uni-helper/vite-plugin-uni-manifest": "0.4.1",
    "@uni-helper/vite-plugin-uni-pages": "0.4.6",
    "@uni-ku/bundle-optimizer": "2.2.0",
    "@uni-ku/root": "1.4.1",
    "@unocss/eslint-plugin": "66.6.7",
    "@unocss/preset-legacy-compat": "66.0.0",
    "c12": "3.3.4",
    "defu": "6.1.7",
    "eslint": "catalog:",
    "jiti": "2.7.0",
    "sass": "1.99.0",
    "unocss": "66.0.0",
    "unplugin-auto-import": "20.0.0",
    "vite-plugin-uni-polyfill": "0.1.0"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "catalog:",
    "@types/node": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vue": "catalog:"
  }
}
