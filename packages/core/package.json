{
  "name": "@univa/core",
  "type": "module",
  "version": "0.0.6",
  "description": "🚀 开箱即用的 uni-app Vite 插件集，提供完整的开发体验",
  "author": "lianghang <libre1103@163.com>",
  "license": "MIT",
  "homepage": "mailto:libre1103@163.com",
  "bugs": {
    "url": "mailto:libre1103@163.com"
  },
  "keywords": [
    "uni-app",
    "vite",
    "plugin",
    "unocss",
    "auto-import",
    "components",
    "uni-helper"
  ],
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./hooks": {
      "import": {
        "types": "./dist/hooks.d.ts",
        "default": "./dist/hooks.js"
      },
      "require": {
        "types": "./dist/hooks.d.cts",
        "default": "./dist/hooks.cjs"
      }
    },
    "./client": {
      "types": "./src/client.d.ts"
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "LICENSE",
    "README.md",
    "dist",
    "src/client.d.ts",
    "src/global.d.ts"
  ],
  "engines": {
    "node": ">=20.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "@dcloudio/uni-app": "^3.0.0-3090920231225001",
    "vite": "^5.2.8",
    "vue": "^3.4.21"
  },
  "dependencies": {
    "@uni-helper/eslint-config": "0.7.3",
    "@uni-helper/plugin-uni": "0.1.0",
    "@uni-helper/uni-pages-types": "^0.4.4",
    "@uni-helper/uni-types": "1.0.0-alpha.8",
    "@uni-helper/unocss-preset-uni": "0.2.11",
    "@uni-helper/vite-plugin-uni-components": "0.2.10",
    "@uni-helper/vite-plugin-uni-layouts": "0.1.11",
    "@uni-helper/vite-plugin-uni-pages": "0.4.4",
    "@uni-ku/root": "^1.4.1",
    "@unocss/eslint-plugin": "66.6.7",
    "@unocss/preset-legacy-compat": "66.0.0",
    "eslint": "10.3.0",
    "sass": "1.99.0",
    "unocss": "66.0.0",
    "unplugin-auto-import": "20.0.0",
    "vite-plugin-uni-polyfill": "0.1.0"
  },
  "devDependencies": {
    "@dcloudio/uni-app": "3.0.0-3090920231225001",
    "@dcloudio/vite-plugin-uni": "3.0.0-3090920231225001",
    "c12": "3.3.4",
    "defu": "6.1.7",
    "tsup": "8.5.1",
    "typescript": "^5.4.0",
    "vite": "5.2.8",
    "vue": "3.4.21"
  }
}
